# Rename this file to .env (drop the .example suffix) and fill in your real key.
# Get a Gemini API key at: https://aistudio.google.com/apikey
# IMPORTANT: image generation requires BILLING enabled on your Google AI Studio
# account — the free tier does not include any image generation model. Add a
# payment method in AI Studio Settings → Billing.
GOOGLE_AI_API_KEY=your-key-here

# Optional: override the image model. Default is gemini-2.5-flash-image (~$0.04/image).
# See https://ai.google.dev/gemini-api/docs/pricing for available models and prices.
# Examples: gemini-3.1-flash-image-preview (newer), gemini-3-pro-image-preview (best quality, more expensive).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
